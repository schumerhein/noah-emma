# Kopieer naar .env.local (lokaal) en zet dezelfde variabelen in Vercel →
# Project → Settings → Environment Variables. Nooit echte waarden committen.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen serverside (API-routes). Nooit NEXT_PUBLIC_ ervoor zetten.
SUPABASE_SERVICE_ROLE_KEY=
# Zelfgekozen geheim; zelfde waarde als header x-webhook-secret in de Supabase Database Webhooks
SUPABASE_WEBHOOK_SECRET=

# --- Site ---
# Productie: https://noah-emma.nl — lokaal: http://localhost:9002
NEXT_PUBLIC_SITE_URL=https://noah-emma.nl

# --- AI (Genkit / Gemini) ---
GEMINI_API_KEY=

# --- E-mail (SendGrid) ---
SENDGRID_API_KEY=

# --- Betalingen (Mollie) ---
# test_... voor Preview, live_... alleen voor Production
MOLLIE_API_KEY=
